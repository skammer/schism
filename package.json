{
  "name": "@skammer/split",
  "version": "0.1.0",
  "description": "Resizable split-pane web components",
  "license": "MIT",
  "type": "module",
  "main": "./dist/split.js",
  "module": "./dist/split.js",
  "types": "./dist/split.d.ts",
  "exports": {
    ".": {
      "types": "./dist/split.d.ts",
      "import": "./dist/split.js"
    },
    "./datastar": {
      "types": "./dist/datastar.d.ts",
      "import": "./dist/datastar.js"
    },
    "./split.css": "./dist/split.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && BUILD_TARGET=datastar vite build && cp src/split.css dist/split.css",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^4.2.0"
  }
}
